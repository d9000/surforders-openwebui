# OpenWebUI Environment Variables

# VPS Configuration
VPS_IP_ADDRESS=your.vps.ip.address
VPS_SSH_USER=ubuntu
VPS_SSH_KEY_PATH=/path/to/private/key

# Database Configuration (PostgreSQL)
DATABASE_URL=postgres://openwebui:your_password@your.vps.ip.address:5432/openwebui
DB_USER=openwebui
DB_PASSWORD=your_secure_password
DB_NAME=openwebui
DB_HOST=your.vps.ip.address
DB_PORT=5432

# OpenWebUI Configuration
OPENWEBUI_PORT=8080
WEBUI_SECRET_KEY=your_random_secret_key_here
OLLAMA_BASE_URL=http://localhost:11434

# Registry (GitHub Container Registry)
GITHUB_USERNAME=your_github_username
KAMAL_REGISTRY_PASSWORD=your_github_token

# Optional: LLM Provider API Keys
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=...
# HUGGING_FACE_API_KEY=...

# Optional: Ollama Settings
# ENABLE_OLLAMA=true
# OLLAMA_API_BASE=http://localhost:11434
