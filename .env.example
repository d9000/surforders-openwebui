# Copy to .env for local docker compose and optional manual Kamal deploys.
# Production uses GitHub Actions secrets (see README).

DEPLOY_HOST=your.vps.hostname.or.ip
DEPLOY_USER=ubuntu

DOCKER_HUB_USER=your-dockerhub-user
DOCKER_HUB_TOKEN=your-dockerhub-token

# Postgres (accessory) and OpenWebUI DB connection — use the SAME value for both.
POSTGRES_PASSWORD=change-me-long-random

# OpenWebUI Configuration
WEBUI_SECRET_KEY=change-me-long-random
OPENWEBUI_PORT=8080

# Optional: LLM Provider Settings
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=...
# OLLAMA_BASE_URL=http://ollama:11434
